{// Zed settings
//
// For information on how to configure Zed, see the Zed//zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
  "instrumentation": {
    "performance_profiler": {
      "enabled": false
    }
  },
  "proxy": "",
  "use_system_window_tabs": false,
  "preview_tabs": {
    "enabled": true
  },
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": false
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_menus": false,
    "show_user_picture": true,
    "show_user_menu": true,
    "show_sign_in": true,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_worktree_name": true,
    "show_branch_name": true,
    "show_branch_status_icon": true
  },
  "debugger": {
    "button": false
  },
  "search": {
    "button": false
  },
  "diagnostics": {
    "button": true
  },
  "terminal": {
    "button": false
  },
  "status_bar": {
    "show_active_file": false,
    "line_endings_button": false,
    "cursor_position_button": false,
    "active_language_button": true
  },
  "project_panel": {
    "starts_open": false,
    "auto_reveal_entries": true,
    "indent_size": 20.0,
    "git_status": true,
    "folder_icons": true,
    "file_icons": true,
    "button": true
  },
  "which_key": {
    "enabled": true
  },
  "git": {
    "disable_git": false
  },
  "active_pane_modifiers": {
    
  },
  "vim_mode": true,
  "cursor_shape": "block",
  "markdown_preview_code_font_family": "JetBrainsMono Nerd Font",
  "markdown_preview_font_family": "JetBrainsMono Nerd Font",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15.0,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "theme": "Vercel Dark",
  "accessible_mode": false
}
